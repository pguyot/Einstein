constant kAppSymbol := '|Port Enabler:40Hz|;
constant kDockAppSymbol := '|HostTCPDock:40Hz|;
constant kDockBasiliskAppSymbol := '|HostBasiliskDock:40Hz|;
constant kPrefsFrame := {
    extr: true,
    mdem: nil,
    infr: nil,
    tblt: nil,
};

constant enablerTemplate := {
    _proto: @164,
    text: "External",
    port: 'extr,
    viewJustify: vjParentFullH + vjSiblingBottomV,
    viewBounds: {left: 8, top: 0, right: 0, bottom: 16},
    viewSetupDoneScript: func() begin
        SetValue(self, 'viewValue, prefsEntry.(port));
        inherited:?viewSetupDoneScript();
    end,
    ValueChanged: func () begin
        prefsEntry.(port) := viewValue;
    end,
};

constant kHostTCPDockTransport := {
    name: "TCP Listener",
    openOptions: func() begin
        return [
            {
                label: "aser",
                type: 'service,
                opCode: 512,
            },
            {
                label: "schp",
                type: 'option,
                opCode: 512,
                form: 'template,
                data: {
                    arglist: ["serv", 0],
                    typelist: ['struct, ['array, 'char, 4], 'ulong],
                },
            },
            {
                label: "siop",
                type: 'option,
                opCode: 256,
                data: {
                    arglist: [0, 0, 8, 57600],
                    typelist: [10, 1, 2, 1, 1],
                },
            },
            // Hardware input flow control: the serial tool lowers RTS when
            // its input buffer fills, and Einstein's TCP port then stops
            // delivering bytes (and, in turn, reading from the socket).
            {
                label: "iflc",
                type: 'option,
                opCode: 512,
                form: 'template,
                data: {
                    arglist: [$\11, $\13, nil, true, nil, nil],
                    typelist: ['struct, 'byte, 'byte, 'boolean, 'boolean, 'boolean, 'boolean],
                },
            },
            {
                label: "mnpn",
                type: 'option,
                opCode: 256,
                data: {
                    arglist: [57600],
                    typelist: [10, 1],
                },
            },
            {
                label: "mnpc",
                type: 'option,
                opCode: 512,
                data: {
                    arglist: [11],
                    typelist: [10, 1],
                },
            },
            {
                label: "mnpa",
                type: 'option,
                opCode: 512,
                data: {
                    arglist: [true],
                    typelist: [10, 5],
                },
            },
            {
                label: "eter",
                type: 'option,
                opCode: 256,
                data: {
                    arglist: [57600],
                    typelist: [10, 1],
                },
            },
        ];
    end,
};

constant kHostBasiliskDockTransport := {
    name: "Basilisk II",
    openOptions: func() begin
        return [
            {
                label: "mnps",
                type: 'service,
                opCode: 512,
            },
            {
                label: "schp",
                type: 'option,
                opCode: 512,
                form: 'template,
                data: {
                    arglist: ["basi", 0],
                    typelist: ['struct, ['array, 'char, 4], 'ulong],
                },
            },
            {
                label: "siop",
                type: 'option,
                opCode: 256,
                data: {
                    arglist: [0, 0, 8, 57600],
                    typelist: [10, 1, 2, 1, 1],
                },
            },
            {
                label: "mnpn",
                type: 'option,
                opCode: 256,
                data: {
                    arglist: [57600],
                    typelist: [10, 1],
                },
            },
            {
                label: "mnpc",
                type: 'option,
                opCode: 512,
                data: {
                    arglist: [11],
                    typelist: [10, 1],
                },
            },
            {
                label: "mnpa",
                type: 'option,
                opCode: 512,
                data: {
                    arglist: [true],
                    typelist: [10, 5],
                },
            },
            {
                label: "eter",
                type: 'option,
                opCode: 256,
                data: {
                    arglist: [57600],
                    typelist: [10, 1],
                },
            },
        ];
    end,
};

{
    app: kAppSymbol,
    text: "Port Enabler",
    enable: PortEnabler.Enable,
    disable: PortEnabler.Disable,

    enablerPrefs: {
        _proto: protoPrefsRollItem,
        overview: "Port Enabler",
        viewBounds: { left: 0, right: 0, top: 0, bottom: 120 },
        height: 40,
        icon: @769,
        prefsEntry: nil,

        viewSetupFormScript: func () begin
            prefsEntry := GetAppPrefs(kAppSymbol, kPrefsFrame);
            inherited:?viewSetupFormScript();
        end,

        viewQuitScript: func () begin
            EntryChangeXmit(prefsEntry, nil);
            prefsEntry := nil;
        end,

        stepChildren: [
            {
                viewClass: 98,
                viewJustify: vjParentFullH + vjParentTopV,
                viewBounds: {left: 8, top: 24, right: 0, bottom: 40},
                viewFlags: vVisible,
                text: "Changes apply after restart",
            },
            {_proto: enablerTemplate, text: "External", port: 'extr},
            {_proto: enablerTemplate, text: "Modem", port: 'mdem},
            {_proto: enablerTemplate, text: "Infrared", port: 'infr},
            {_proto: enablerTemplate, text: "Tablet", port: 'tblt},
        ],
    },

    devInstallScript: func (partFrame, removeFrame) begin
        RegPrefs(kAppSymbol, partFrame.enablerPrefs);
        prefsEntry := GetAppPrefs(kAppSymbol, kPrefsFrame);
        foreach port, default in kPrefsFrame do
          if prefsEntry.(port) then partFrame:enable(SPrintObject(port), nil, nil);
        local err := partFrame:enable("serv", nil, nil);
        if GlobalFnExists('RegDesktopConnTransport) then begin
            if err = 0 then
                RegDesktopConnTransport(kDockAppSymbol, kHostTCPDockTransport);
        end;
        err := partFrame:enable("basi", nil, nil);
        if GlobalFnExists('RegDesktopConnTransport) then begin
            if err = 0 then
                RegDesktopConnTransport(kDockBasiliskAppSymbol, kHostBasiliskDockTransport);
        end;
        return removeFrame;
    end,

    devRemoveScript: func (partFrame) begin
        if GlobalFnExists('UnregDesktopConnTransport) then begin
            UnregDesktopConnTransport(kDockAppSymbol);
            UnregDesktopConnTransport(kDockBasiliskAppSymbol);
        end;
        foreach port, default in kPrefsFrame do
            partFrame:disable(SPrintObject(port));
        partFrame:disable("serv");
        partFrame:disable("basi");
        UnRegPrefs(kAppSymbol);
    end,

    InstallScript: func (partFrame) begin
        return partFrame:devInstallScript (partFrame, EnsureInternal ({ removeScript: partFrame.devRemoveScript }));
    end,
};
